ARG AEGIS_CODE_BASE_IMAGE=aegis-kali:code
FROM ${AEGIS_CODE_BASE_IMAGE}
ENV AEGIS_CODE_SEMGREP_CONFIG=/opt/aegis-semgrep-rules/aegis-production-baseline-v1.yml
USER root
COPY runner/code_service.py /opt/aegis-runner/code_service.py
COPY semgrep-rules/aegis-production-baseline-v1.yml /opt/aegis-semgrep-rules/aegis-production-baseline-v1.yml
RUN mkdir -p /var/lib/aegis-semgrep /opt/aegis-semgrep-rules \
    && chown 10001:10001 /var/lib/aegis-semgrep \
    && chmod 0700 /var/lib/aegis-semgrep \
    && chmod 0444 /opt/aegis-semgrep-rules/aegis-production-baseline-v1.yml \
    && SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0 \
       /opt/aegis-code-tools/bin/semgrep --json --no-rewrite-rule-ids --no-git-ignore \
       --config /opt/aegis-semgrep-rules/aegis-production-baseline-v1.yml \
       /opt/aegis-runner/code_service.py >/tmp/aegis-semgrep-baseline-build-proof.json \
    && test -s /tmp/aegis-semgrep-baseline-build-proof.json \
    && rm -f /tmp/aegis-semgrep-baseline-build-proof.json
RUN chmod 0755 /opt/aegis-runner/code_service.py \
    && python3 -m py_compile /opt/aegis-runner/code_service.py \
    && python3 - <<'PY'
import json
from pathlib import Path
path=Path('/opt/aegis-runner/runtime-manifest.json')
runtime=json.loads(path.read_text(encoding='utf-8'))
assert runtime['profile']=='code', runtime
assert runtime['dispatch_enabled'] is False, runtime
assert runtime['dispatch_state']=='accepted-no-dispatch', runtime
assert 'code.semgrep' in runtime['profile_capabilities'], runtime
assert runtime['profile_tools']['semgrep']['version']=='1.177.0', runtime
runtime['dispatch_enabled']=True
runtime['dispatch_state']='semantic-code-provider'
runtime['dispatch_capabilities']=['code.semgrep']
runtime['provider_bundle']='aegis-kali-code-semgrep-canary-v1'
path.write_text(json.dumps(runtime,sort_keys=True,separators=(',',':'))+'\n',encoding='utf-8')
PY
RUN python3 - <<'PY'
import json
from pathlib import Path
runtime=json.loads(Path('/opt/aegis-runner/runtime-manifest.json').read_text(encoding='utf-8'))
assert runtime['profile']=='code', runtime
assert runtime['dispatch_enabled'] is True, runtime
assert runtime['dispatch_state']=='semantic-code-provider', runtime
assert runtime['dispatch_capabilities']==['code.semgrep'], runtime
assert runtime['provider_bundle']=='aegis-kali-code-semgrep-canary-v1', runtime
PY
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "/opt/aegis-runner/code_service.py"]
