FROM kalilinux/kali-rolling@sha256:c6d78f57ebfdd9fec428a8b04f74876e66fddd08dfd328c076224a552e7332a3

ARG AEGIS_RUNNER_VERSION=0.1.0
ARG BUILD_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0

ENV DEBIAN_FRONTEND=noninteractive \
    AEGIS_RUNNER_VERSION=${AEGIS_RUNNER_VERSION} \
    AEGIS_BUILD_COMMIT=${BUILD_COMMIT} \
    AEGIS_BASE_IMAGE_DIGEST=sha256:c6d78f57ebfdd9fec428a8b04f74876e66fddd08dfd328c076224a552e7332a3 \
    AEGIS_RUNNER_PROFILE=base \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

LABEL org.opencontainers.image.revision=${BUILD_COMMIT} \
      org.opencontainers.image.base.digest=sha256:c6d78f57ebfdd9fec428a8b04f74876e66fddd08dfd328c076224a552e7332a3 \
      io.aegisscan.runner.version=${AEGIS_RUNNER_VERSION} \
      io.aegisscan.runner.profile=base

RUN test -n "$BUILD_COMMIT" && test "$BUILD_COMMIT" != "unknown" \
    && test "$SOURCE_DATE_EPOCH" -gt 0

# Foundation packages are pinned to exact versions. The immutable base image
# is intentionally paired with Kali's point-release snapshot repository so an
# apt metadata refresh cannot invalidate those pins as kali-rolling advances.
# Package-manager logs, caches, and user login accounting are removed/disabled
# because they contain execution-time state that must not influence the image.
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/kali.sources ]; then \
        sed -i 's/^Suites: kali-rolling$/Suites: kali-last-snapshot/' /etc/apt/sources.list.d/kali.sources; \
        grep -Fxq 'Suites: kali-last-snapshot' /etc/apt/sources.list.d/kali.sources; \
    else \
        sed -i 's/ kali-rolling / kali-last-snapshot /' /etc/apt/sources.list; \
        grep -Eq '^[[:space:]]*deb .* kali-last-snapshot ' /etc/apt/sources.list; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates=20260816 \
        coreutils=9.10-1 \
        jq=1.8.2-1 \
        procps=2:4.0.6-3 \
        python3=3.14.7-3 \
        tini=0.19.0-6+b2 \
    && test "$(dpkg-query -W -f='${Version}' python3)" = "3.14.7-3" \
    && test "$(dpkg-query -W -f='${Version}' tini)" = "0.19.0-6+b2" \
    && test "$(dpkg-query -W -f='${Version}' jq)" = "1.8.2-1" \
    && rm -rf \
        /var/lib/apt/lists/* \
        /var/cache/apt/archives/* \
        /var/cache/debconf/*-old \
        /var/cache/ldconfig/aux-cache \
        /var/log/apt/* \
        /var/log/dpkg.log \
        /var/log/alternatives.log \
        /var/log/faillog \
        /var/log/lastlog \
    && find /etc /usr /var -xdev \
        ! -path /etc/hosts \
        ! -path /etc/hostname \
        ! -path /etc/resolv.conf \
        -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

RUN groupadd --gid 10001 aegis \
    && useradd --no-log-init --uid 10001 --gid aegis --create-home --shell /usr/sbin/nologin aegis \
    && mkdir -p /opt/aegis-runner /workspace /artifacts \
    && chown -R aegis:aegis /opt/aegis-runner /workspace /artifacts \
    && rm -f /var/log/faillog /var/log/lastlog \
    && find /etc /home /opt /workspace /artifacts /var -xdev \
        ! -path /etc/hosts \
        ! -path /etc/hostname \
        ! -path /etc/resolv.conf \
        -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

COPY runner /opt/aegis-runner
RUN chmod 0755 /opt/aegis-runner/runner.py /opt/aegis-runner/entrypoint.sh \
    && python3 -c 'import json,os,pathlib,subprocess; p=["ca-certificates","coreutils","jq","procps","python3","tini"]; v={x:subprocess.check_output(["dpkg-query","-W","-f=${Version}",x],text=True).strip() for x in p}; d={"runtime":"aegis-kali","runner_version":os.environ["AEGIS_RUNNER_VERSION"],"profile":os.environ["AEGIS_RUNNER_PROFILE"],"base_image_digest":os.environ["AEGIS_BASE_IMAGE_DIGEST"],"build_commit":os.environ["AEGIS_BUILD_COMMIT"],"foundation_packages":v}; pathlib.Path("/opt/aegis-runner/runtime-manifest.json").write_text(json.dumps(d,sort_keys=True,separators=(",",":"))+"\n")' \
    && chmod 0444 /opt/aegis-runner/runtime-manifest.json \
    && find /opt/aegis-runner -xdev -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini","--","/opt/aegis-runner/entrypoint.sh"]
