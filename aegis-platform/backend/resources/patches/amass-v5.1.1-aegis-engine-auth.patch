+const (
+	MaxBulkItems     = 1000
+	engineAuthHeader = "X-Aegis-Amass-Token"
+)
+
+type engineAuthTransport struct {
+	base  http.RoundTripper
+	token string
+}
+
+func (t *engineAuthTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	clone := req.Clone(req.Context())
+	clone.Header = req.Header.Clone()
+	clone.Header.Set(engineAuthHeader, t.token)
+	return t.base.RoundTrip(clone)
+}
+
+func engineAuthToken() (string, error) {
+	token := strings.TrimSpace(os.Getenv("AEGIS_AMASS_ENGINE_TOKEN"))
+	if len(token) != 64 || token != strings.ToLower(token) {
+		return "", fmt.Errorf("AEGIS_AMASS_ENGINE_TOKEN must be 64 lowercase hex characters")
+	}
+	if _, err := hex.DecodeString(token); err != nil {
+		return "", fmt.Errorf("AEGIS_AMASS_ENGINE_TOKEN must be 64 lowercase hex characters")
+	}
+	return token, nil
+}
 
