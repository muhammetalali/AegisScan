  "mode_semantics": {
    "ASSISTED_EXISTING": {
      "execution_backend": "Kali profile + existing Aegis evaluator -> governed analyst confirmation",
      "runtime_action": "Run current evidence capability from Kali; keep semantic decision/attestation in Aegis control plane; do not auto-pass from tool output alone.",
      "evidence_contract": "Runtime provenance + observation + evidence refs + analyst attestation/decision",
      "kali_requirement": "required"
    },
    "AUTO_EXISTING": {
      "execution_backend": "Kali profile -> existing Aegis capability adapter -> normalized evidence",
      "runtime_action": "Migrate/repackage existing capability into pinned Aegis Kali image; preserve option allowlists, scope checks, timeouts and parser contract.",
      "evidence_contract": "Runtime provenance + normalized observation + evidence fingerprint + WSTG coverage result",
      "kali_requirement": "required"
    },
    "GAP_NATIVE_SMALL": {
      "execution_backend": "New bounded Aegis validator packaged and executed inside Kali profile",
      "runtime_action": "Implement the small native validator only; package it in the relevant Kali profile and add Reality tests before enabling.",
      "evidence_contract": "Validator result + bounded request/response semantics + fingerprint + runtime provenance",
      "kali_requirement": "required"
    },
    "MANUAL_GOVERNED": {
      "execution_backend": "Aegis governed workflow; Kali used only for bounded evidence collection when useful",
      "runtime_action": "Do not invent automation. Create governed test work item with evidence references; allow Kali support actions only under explicit scope/budget.",
      "evidence_contract": "Actor/time/scope + manual attestation + evidence refs + decision reason",
      "kali_requirement": "manual_only"
    },
    "CONDITIONAL_NA": {
      "execution_backend": "Applicability gate first; Kali profile only when technology is present",
      "runtime_action": "Evaluate applicability from discovery evidence; default N/A when absent, otherwise dispatch the bounded Kali/browser test.",
      "evidence_contract": "Applicability reason; if applicable, normal runtime/evidence contract",
      "kali_requirement": "conditional"
    }
  }
