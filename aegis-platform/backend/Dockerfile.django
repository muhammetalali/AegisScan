FROM projectdiscovery/nuclei:v3.11.1-amd64 AS nuclei
FROM golang:1.26-bookworm AS pd_tools
RUN set -eux; \
    export CGO_ENABLED=0 GOOS=linux GOARCH=amd64; \
    export GOPROXY=https://proxy.golang.org,direct GOSUMDB=sum.golang.org GODEBUG=http2client=0; \
    go_install_with_retry() { \
        module="$1"; \
        attempt=1; \
        until go install "$module"; do \
            if [ "$attempt" -ge 5 ]; then \
                echo "go install failed after $attempt attempts: $module" >&2; \
                exit 1; \
            fi; \
            sleep_seconds=$((attempt * 15)); \
            echo "retrying go install for $module in ${sleep_seconds}s" >&2; \
            sleep "$sleep_seconds"; \
            attempt=$((attempt + 1)); \
        done; \
    }; \
    go_install_with_retry github.com/projectdiscovery/httpx/cmd/httpx@v1.10.0; \
    go_install_with_retry github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.16.0; \
    go_install_with_retry github.com/projectdiscovery/katana/cmd/katana@v1.7.0
FROM ghcr.io/aquasecurity/trivy:0.74.0 AS trivy
FROM trufflesecurity/trufflehog:3.97.1 AS trufflehog

FROM alpine/git:2.47.2 AS nuclei_templates
RUN git clone --depth 1 https://github.com/projectdiscovery/nuclei-templates.git /opt/nuclei-templates \
    && rm -rf /opt/nuclei-templates/.git

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/django_project \
    NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates \
    AEGIS_WORDLIST_ROOT=/opt/aegis-wordlists

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl chromium nmap masscan libpcap0.8 ca-certificates libcap2-bin \
        binutils checksec binwalk libimage-exiftool-perl xxd gdb \
        gobuster ffuf dirb dnsenum fierce wafw00f nbtscan \
        git openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=nuclei /usr/local/bin/nuclei /usr/local/bin/nuclei
COPY --from=pd_tools /go/bin/httpx /usr/local/bin/httpx
COPY --from=pd_tools /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=pd_tools /go/bin/katana /usr/local/bin/katana
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=trufflehog /usr/bin/trufflehog /usr/local/bin/trufflehog
COPY --from=nuclei_templates /opt/nuclei-templates /opt/nuclei-templates
RUN chmod 0755 /usr/local/bin/nuclei /usr/local/bin/httpx /usr/local/bin/subfinder /usr/local/bin/katana /usr/local/bin/trivy /usr/local/bin/trufflehog \
    && /usr/local/bin/nuclei -version \
    && /usr/local/bin/httpx -version \
    && /usr/local/bin/subfinder -version \
    && /usr/local/bin/katana -version \
    && chromium --version \
    && /usr/local/bin/trivy --version \
    && /usr/local/bin/trufflehog --version \
    && test -f /opt/nuclei-templates/http/misconfiguration/http-missing-security-headers.yaml

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir semgrep checkov==3.3.16

COPY . .
RUN mkdir -p /opt/aegis-wordlists \
    && cp /app/resources/wordlists/web-common.txt /opt/aegis-wordlists/web-common.txt \
    && chmod 0444 /opt/aegis-wordlists/web-common.txt

RUN groupadd --gid 10001 aegis \
    && useradd --uid 10001 --gid aegis --create-home --shell /usr/sbin/nologin aegis \
    && mkdir -p /app/staticfiles /app/media \
    && chown -R aegis:aegis /app \
    && chmod 0755 /app/scanner-worker-entrypoint.sh /app/fastapi_app/services/browser_security_probe.py \
    && nmap_binary="$(readlink -f "$(command -v nmap)")" \
    && masscan_binary="$(readlink -f "$(command -v masscan)")" \
    && test -f "$nmap_binary" \
    && test -f "$masscan_binary" \
    && test -z "$(getcap "$nmap_binary")" \
    && test -z "$(getcap "$masscan_binary")"

# Build-time capability reality: every binary listed here is a real executable
# available to the unprivileged scanner worker, not merely a registry entry.
RUN command -v nmap >/dev/null \
    && command -v masscan >/dev/null \
    && command -v semgrep >/dev/null \
    && command -v nuclei >/dev/null \
    && command -v curl >/dev/null \
    && command -v chromium >/dev/null \
    && command -v httpx >/dev/null \
    && command -v subfinder >/dev/null \
    && command -v katana >/dev/null \
    && command -v trivy >/dev/null \
    && command -v trufflehog >/dev/null \
    && command -v checkov >/dev/null \
    && command -v strings >/dev/null \
    && command -v objdump >/dev/null \
    && command -v readelf >/dev/null \
    && command -v checksec >/dev/null \
    && command -v binwalk >/dev/null \
    && command -v xxd >/dev/null \
    && command -v gdb >/dev/null \
    && command -v exiftool >/dev/null \
    && command -v gobuster >/dev/null \
    && command -v ffuf >/dev/null \
    && command -v dirb >/dev/null \
    && command -v dnsenum >/dev/null \
    && command -v fierce >/dev/null \
    && command -v wafw00f >/dev/null \
    && command -v nbtscan >/dev/null \
    && test -s /opt/aegis-wordlists/web-common.txt \
    && command -v capsh >/dev/null

EXPOSE 8000

USER 10001:10001

CMD ["gunicorn", "django_project.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "120"]
