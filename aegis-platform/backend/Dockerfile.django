FROM projectdiscovery/nuclei:v3.11.1-amd64 AS nuclei

FROM alpine/git:2.47.2 AS nuclei_templates
RUN git clone --depth 1 https://github.com/projectdiscovery/nuclei-templates.git /opt/nuclei-templates \
    && rm -rf /opt/nuclei-templates/.git

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/django_project \
    NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nmap masscan ca-certificates libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=nuclei /usr/local/bin/nuclei /usr/local/bin/nuclei
COPY --from=nuclei_templates /opt/nuclei-templates /opt/nuclei-templates
RUN chmod 0755 /usr/local/bin/nuclei \
    && /usr/local/bin/nuclei -version \
    && test -f /opt/nuclei-templates/http/misconfiguration/http-missing-security-headers.yaml

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir semgrep

COPY . .

RUN groupadd --gid 10001 aegis \
    && useradd --uid 10001 --gid aegis --create-home --shell /usr/sbin/nologin aegis \
    && mkdir -p /app/staticfiles /app/media \
    && chown -R aegis:aegis /app \
    && setcap cap_net_raw,cap_net_admin+eip /usr/bin/nmap /usr/bin/masscan

# Verify required scanner/analysis binaries are installed without relying on
# non-zero CLI exit semantics (masscan prints its version but returns 1).
RUN command -v nmap >/dev/null \
    && command -v masscan >/dev/null \
    && command -v semgrep >/dev/null

EXPOSE 8000

USER 10001:10001

CMD ["gunicorn", "django_project.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "120"]
