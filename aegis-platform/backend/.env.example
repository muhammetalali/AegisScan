# Development defaults only. Never commit real secrets.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-separate-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://aegis:change-me@localhost:5432/aegisdb
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
AUTH_COOKIE_SECURE=False
FRONTEND_URL=http://localhost:5173

# Explicit server-side allow-list for real security execution.
# Examples: 10.0.0.0/24, 192.168.1.10, app.internal.example, *.internal.example
# Keep empty until the organization's approved scope is configured.
AUTHORIZED_SCAN_TARGETS=

# Required when the production monitoring overlay is enabled. Production
# preflight accepts HTTPS destinations only and rejects credentials in the URL,
# fragments, loopback and link-local hosts.
ALERT_WEBHOOK_URL=
PROMETHEUS_RETENTION=15d


# Production remote backup plane. Production preflight requires this to be
# explicitly enabled. The credential/key values themselves stay in private
# files owned by AEGIS_BACKUP_RUNTIME_UID and mode 0600; do not put secrets here.
AEGIS_REMOTE_BACKUP_ENABLED=false
AEGIS_BACKUP_S3_ENDPOINT=
AEGIS_BACKUP_S3_REGION=us-east-1
AEGIS_BACKUP_S3_BUCKET=
AEGIS_BACKUP_S3_PREFIX=aegisscan/postgres
AEGIS_BACKUP_S3_ADDRESSING_STYLE=path
AEGIS_BACKUP_REQUIRE_VERSIONING=true
AEGIS_BACKUP_INTERVAL_SECONDS=86400
AEGIS_BACKUP_RETRY_SECONDS=300
AEGIS_BACKUP_DUMP_TIMEOUT_SECONDS=7200
AEGIS_BACKUP_UPLOAD_TIMEOUT_SECONDS=7200
AEGIS_BACKUP_RUNTIME_UID=10001
AEGIS_BACKUP_RUNTIME_GID=10001
AEGIS_BACKUP_S3_CREDENTIALS_FILE=
AEGIS_BACKUP_ENCRYPTION_KEY_FILE=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AegisScan <noreply@localhost>
SENTRY_DSN=
LOG_LEVEL=INFO
POSTGRES_DB=aegisdb
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
