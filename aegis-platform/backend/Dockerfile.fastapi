FROM mirror.gcr.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/django_project

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nmap masscan ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN set -eux; \
    pip_install_with_retry() { \
        attempt=1; \
        while true; do \
            if python -m pip install --no-cache-dir --retries 5 --timeout 120 "$@"; then \
                return 0; \
            fi; \
            if [ "$attempt" -ge 4 ]; then \
                echo "pip install failed after $attempt attempts: $*" >&2; \
                return 1; \
            fi; \
            sleep_seconds=$((attempt * 10)); \
            echo "retrying pip install in ${sleep_seconds}s: $*" >&2; \
            sleep "$sleep_seconds"; \
            attempt=$((attempt + 1)); \
        done; \
    }; \
    pip_install_with_retry -r requirements.txt; \
    pip_install_with_retry semgrep

COPY . .

RUN groupadd --gid 10001 aegis \
    && useradd --uid 10001 --gid aegis --create-home --shell /usr/sbin/nologin aegis \
    && mkdir -p /var/lib/aegis-semgrep/uploads \
    && chown -R aegis:aegis /app /var/lib/aegis-semgrep \
    && chmod 0700 /var/lib/aegis-semgrep

EXPOSE 8001

USER 10001:10001

CMD ["uvicorn", "fastapi_app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "4", "--loop", "uvloop", "--http", "httptools", "--no-access-log"]
