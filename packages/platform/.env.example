# Platform runtime configuration template.
# Copy to .env and fill every required value with real environment-specific values.
# Never commit the resulting .env file or production secrets.

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Django / API security
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
FASTAPI_SECRET_KEY=
JWT_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email delivery. Leave the application stopped until real SMTP credentials are configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Runtime
AEGIS_ENV=development
AEGIS_CONTAINERIZED=1
AEGIS_HOST_GATEWAY=host.docker.internal
LOG_TO_FILE=0
CELERY_DEFAULT_WORKER_CONCURRENCY=2
CELERY_WORKFLOW_WORKER_CONCURRENCY=2
CELERY_REPORT_WORKER_CONCURRENCY=2
