# Local platform runtime configuration.
# Never commit production secrets here.
POSTGRES_DB=aegisdb
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=aegisscan-local-dev-secret-change-me
FASTAPI_SECRET_KEY=aegisscan-local-fastapi-secret-change-me
JWT_SECRET_KEY=aegisscan-local-jwt-secret-change-me-0123456789
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AegisScan <noreply@aegisscan.local>
AEGIS_ENV=development
CELERY_DEFAULT_WORKER_CONCURRENCY=2
CELERY_WORKFLOW_WORKER_CONCURRENCY=2
CELERY_REPORT_WORKER_CONCURRENCY=2
