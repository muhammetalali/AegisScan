# Copy into a secret manager / CI environment. Do not commit real values.
AEGIS_ENV=production
DJANGO_SECRET_KEY=<32+ random bytes>
JWT_SECRET_KEY=<32+ random bytes>
FASTAPI_SECRET_KEY=<32+ random bytes>
DATABASE_URL=postgresql://<user>:<password>@<managed-postgres-host>:5432/<database>?sslmode=require
REDIS_URL=rediss://:<password>@<managed-redis-host>:6380/0
CELERY_BROKER_URL=rediss://:<password>@<managed-redis-host>:6380/1
CELERY_RESULT_BACKEND=rediss://:<password>@<managed-redis-host>:6380/2
REDIS_SSL_CERT_REQS=required
DJANGO_API_URL=https://api.example.com/api/v1
CORS_ALLOWED_ORIGINS=https://app.example.com
OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
DJANGO_WORKERS=3
FASTAPI_WORKERS=3
CELERY_DEFAULT_WORKER_CONCURRENCY=2
CELERY_WORKFLOW_WORKER_CONCURRENCY=2
CELERY_REPORT_WORKER_CONCURRENCY=2
