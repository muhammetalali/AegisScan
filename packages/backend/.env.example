# AegisScan ITSM integration template
# NEVER commit real URLs, API tokens, passwords, or other production secrets.
# Real values belong in the local .env file or GitHub Actions Secrets.

# Runtime mode: real | sandbox
AEGIS_ITSM_MODE=real

# Jira (required for real Jira integration)
JIRA_BASE_URL=https://YOUR-INSTANCE.atlassian.net
JIRA_API_TOKEN=REPLACE_WITH_SECRET
JIRA_USER_EMAIL=REPLACE_WITH_ACCOUNT_EMAIL
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task

# ServiceNow (required for real ServiceNow integration)
SERVICENOW_BASE_URL=https://YOUR-INSTANCE.service-now.com
SERVICENOW_API_TOKEN=REPLACE_WITH_SECRET
# Or use basic auth instead of SERVICENOW_API_TOKEN:
# SERVICENOW_USERNAME=REPLACE_WITH_USERNAME
# SERVICENOW_PASSWORD=REPLACE_WITH_PASSWORD
SERVICENOW_TABLE=incident
SERVICENOW_IDEMPOTENCY_FIELD=correlation_id
# Optional custom field carrying the originating AegisScan finding ID:
# SERVICENOW_FINDING_FIELD=u_aegisscan_finding_id

# Real E2E is intentionally opt-in.
AEGIS_ITSM_E2E_ENABLE=0
AEGIS_ITSM_E2E_ACTOR=e2e-runner
AEGIS_ITSM_E2E_OWNER=security-engineering
