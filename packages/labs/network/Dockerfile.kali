FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
        iputils-ping \
        masscan \
        nmap \
        python3 \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /bin/bash aegislab
COPY --chown=10001:10001 agent.py /home/aegislab/agent.py

USER 10001:10001
WORKDIR /home/aegislab

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
