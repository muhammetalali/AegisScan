FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
        iputils-ping \
        masscan \
        nmap \
        python3 \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY agent.py /home/aegislab/agent.py
WORKDIR /home/aegislab

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "/home/aegislab/agent.py"]
